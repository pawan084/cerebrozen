# Python
__pycache__/
*.py[cod]
.venv/
venv/
# `env/` too, not just venv/.venv: a Windows virtualenv under this name (plus a
# second at backend/env/) was committed whole — 10,804 files including Scripts/*.exe.
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Env / secrets — never commit real keys
.env
.env.*
!.env.example
!.env.*.example
!*.env.example
*.pem
*.p8
# …except Apple's PUBLIC root cert, which pins App Store receipt chains
!backend/app/certs/AppleRootCA-G3.pem

# Node / Next.js
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# Generated media (narration MP3s — dev api bind-mount writes them here)
backend/media/

# Test / coverage artifacts
playwright-report/
test-results/
.coverage
htmlcov/

# Scratch / references — not part of the production build
temp/
*.log

# OS / editor
.DS_Store
# macOS writes __MACOSX/._* AppleDouble stubs when unzipping; 3,466 of them were
# committed alongside an unpacked third-party APK.
__MACOSX/
.idea/
.vscode/

# Unpacked/downloaded app bundles used as references — never source
*.xapk
*.apk
*.aab

# Xcode
xcuserdata/
*.xcresult
DerivedData/
build/
*.xcuserstate

# Local agent settings (keep shared skills/config, drop local prefs)
.claude/settings.local.json

# Large screenshot assets — kept on disk, out of git history (regenerate via tests)
/screenshots/

# Session-generated deliverables (regenerate as needed; not source)
/CereBro-screens-*.zip
/CereBro-showcase.zip
/CereBro-showcase/
/CereBro-onboarding-flow.png

# fastlane (iOS lives at apps/ios)
apps/ios/fastlane/report.xml
apps/ios/fastlane/Preview.html
apps/ios/fastlane/test_output/
apps/ios/fastlane/README.md
apps/ios/build/
apps/ios/*.ipa
apps/ios/*.app.dSYM.zip
apps/ios/Gemfile.lock
**/.env

# Local design reference / mockups (large, not source)
ref/

# Dev-stack PID file written by `npm run stack:up` — runtime state, not source.
/.launch-dev.pids

# A stray working copy of the SIBLING codebase (the services/engine +
# services/platform layout lives on origin/main-sibling-legacy, not here).
# 754 MB, referenced by nothing tracked in this repo, and it carries a real
# services/engine/.env plus .venv/.next/*.db — none of which may enter history.
# Ignored rather than deleted: it is not this project's to remove.
/services/
