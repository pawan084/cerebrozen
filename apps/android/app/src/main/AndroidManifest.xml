<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice companion: on-device speech-to-text (optional; degrades to text). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Local daily reminder notifications (no FCM; scheduled via AlarmManager). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the daily reminder alarm after a reboot (alarms don't persist). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Background ambient audio as a foreground media service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- ExoPlayer setWakeMode() (keeps overnight narration/streams alive under Doze). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Tactile feedback (calm haptics on presses, check-ins, celebrations). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional last-night sleep prefill from Health Connect (read-only). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- enableOnBackInvokedCallback: targetSdk 35 opt-in to predictive back —
         the system back gesture previews the destination instead of cutting. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CereBro">

        <!-- windowSoftInputMode=adjustResize, not the default adjustUnspecified.
             Left unset, the system chose PAN for our scrolling screens: opening
             the keyboard slid the whole window upward, so content that sat
             correctly below the status bar was pushed behind it — a Talk bubble
             drawn straight through the clock. No padding inside the app can fix
             a window the OS is translating; resizing keeps the insets meaningful. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CereBro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect opens the app for the permissions rationale / privacy. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".audio.AmbientService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".audio.SoundscapeService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Remote nudges. Never started without a google-services.json:
             Firebase's init provider finds no config, so nothing dispatches
             here and the app runs exactly as it did before. -->
        <service
            android:name=".notify.CereBroMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
