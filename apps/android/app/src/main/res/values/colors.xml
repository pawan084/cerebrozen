<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background and, on Android 12+, the platform splash the
         launcher icon sits on. It MUST equal the page ground Compose paints one
         frame later, or every cold launch steps from one colour to another.

         Light Dawn is the default appearance (docs/REDESIGN_V2.md §2), so this
         file holds DawnPalette.night and values-night/ holds NightPalette.night.
         Before the Light Dawn port there was only the dark value, which meant a
         light-theme device flashed deep indigo on every launch.

         Gated by ThemeTokensTest (both qualifiers). -->
    <color name="night">#FFF7F3EC</color>
</resources>
