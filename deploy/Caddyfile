# CereBrozen reverse proxy + automatic HTTPS (Let's Encrypt).
# Caddy provisions and renews TLS certs automatically for every domain below,
# as long as ports 80/443 are open and DNS points here (194.163.182.1).

{
	email admin@cerebrozen.in
}

# Shared security headers for every site. The CSP for the three Next.js sites
# comes from each app's own middleware.ts (per-request script NONCE — no
# 'unsafe-inline' scripts; Caddy passes the upstream header through). Only the
# API block sets a CSP here, since FastAPI serves no HTML of its own.
# The `?` prefix means "set this only if the upstream did not". It is load
# bearing, not tidiness: without it Caddy APPENDS to a header the app already
# sent, and the API sets its own X-Frame-Options and Referrer-Policy. Responses
# from api.cerebrozen.in carried `X-Frame-Options: SAMEORIGIN, DENY` and
# `Referrer-Policy: strict-origin-when-cross-origin, no-referrer` — and a browser
# that sees two disagreeing XFO values treats the header as invalid and ignores
# it, so the strictest site in the estate was the one left without it. Found on
# 2026-08-23 by e2e/tests/edge-headers.spec.ts, the first test that ever reached
# this file; neither the static check nor a direct-to-app request can see it.
#
# So the edge sets a FLOOR and a site may be stricter — which is the arrangement
# the API was already written for (DENY and no-referrer, deliberately, because it
# renders no documents). The floor is only a floor if nothing weakens it, so the
# e2e spec asserts each site's final value is at least as strict as this.
(security_headers) {
	# One `header` directive per field, deliberately — NOT one block with five
	# fields in it, which is what this was until 2026-08-23 and why the API was
	# shipping without HSTS.
	#
	# `?` means "set only if the upstream did not". Caddy compiles a block of
	# `?` fields into a SINGLE handler with a SINGLE require-matcher covering all
	# of them, so the ops apply only when EVERY one is absent. FastAPI sets its
	# own X-Content-Type-Options, X-Frame-Options and Referrer-Policy — so the
	# matcher never fired for api.cerebrozen.in and it received none of the five,
	# HSTS and Permissions-Policy included. Split like this, each field gets its
	# own matcher and is decided on its own.
	#
	# Before `?` was there at all, the same block APPENDED instead, and the API
	# answered `X-Frame-Options: SAMEORIGIN, DENY` — two disagreeing values,
	# which a browser treats as invalid and ignores. So the strictest site in the
	# estate has been the one without framing protection, in one form or another,
	# for as long as this file has existed.
	#
	# Both were found by e2e/tests/edge-headers.spec.ts, the first test that ever
	# reached this file. Neither the static gate nor a direct-to-app request can
	# see either one: the header is present in the source, and present on the
	# app's own response — it is the composition that was wrong.
	#
	# The arrangement is now: the edge sets a FLOOR, a site may be stricter. The
	# spec asserts each site's final value is at least as strict as the floor,
	# because a floor nothing enforces is not one.
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header ?X-Content-Type-Options "nosniff"
	header ?X-Frame-Options "SAMEORIGIN"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

# www → apex: one canonical host, so search engines never split the site's
# authority across two.
www.cerebrozen.in {
	redir https://cerebrozen.in{uri} permanent
}

# Landing site (Next.js)
cerebrozen.in {
	import security_headers
	# Brand art and screenshots are content-addressed by redeploy, not by name —
	# but they change rarely and re-downloading them on every visit is the
	# larger cost. A day of cache with revalidation is the honest middle.
	@static path /brand/* /screens/* /apple-touch-icon.png
	header @static Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	encode gzip zstd
	reverse_proxy web:3000
}

# Admin dashboard (Next.js)
admin.cerebrozen.in {
	import security_headers
	# An ops dashboard has no business in a search index (the app's layout
	# metadata says the same; this covers every response, HTML or not).
	header X-Robots-Tag "noindex, nofollow"
	encode gzip zstd
	reverse_proxy admin:3001
}

# Web app (Next.js — authenticated client)
app.cerebrozen.in {
	import security_headers
	encode gzip zstd
	reverse_proxy app:3002
}

# Organisation portal (ref/portal.html). Commented out, not omitted: the app
# builds and runs, but only 10 of the reference's 36 screens exist and there is
# no auth in front of it yet (AUTH-01/AUTH-02 are among the unbuilt). Publishing
# an unauthenticated console on a real subdomain would be the mistake, so this
# block waits for the sign-in screens. Until then `docker compose up` serves it
# on :3003 for local work, and CI builds and e2e-walks it.
# portal.cerebrozen.in {
# 	import security_headers
# 	encode gzip zstd
# 	reverse_proxy portal:3003
# }

# API (FastAPI)
api.cerebrozen.in {
	import security_headers
	# JSON-only origin: a locked-down CSP as defense-in-depth against
	# content-type confusion (nothing here renders as a document).
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	encode gzip zstd
	reverse_proxy api:8000
}

# mcp.cerebrozen.in: dropped 2026-07-04 (was reserved with nothing behind it —
# a dangling subdomain invites takeover-style confusion). Remove the DNS record
# too; re-add a block here only when an MCP service actually ships.
